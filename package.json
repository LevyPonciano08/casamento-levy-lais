{
  "name": "casamento-levy-lais",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node server/build.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:import": "node --env-file-if-exists=.env server/import-supabase.js",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.js",
    "test": "node --env-file-if-exists=.env --test server/*.test.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
